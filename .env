# For clusters:minikube-load-images without image references - loads <registry>/<site>:<image>-latest
# No default - set it in the root .env, e.g. registry.digitalocean.com/<your-registry>
MINIKUBE_REGISTRY=
# Addons enabled by clusters:minikube-up, and the container runtime it starts with
MINIKUBE_ADDONS=dashboard,metrics-server,traefik
MINIKUBE_CONTAINER_RUNTIME=containerd
# The jetstack cert-manager chart version clusters:minikube-cert-manager installs
MINIKUBE_CERT_MANAGER_VERSION=v1.15.2
# The localhost port clusters:minikube-port-forward serves a site on
MINIKUBE_PORT_FORWARD=8090
